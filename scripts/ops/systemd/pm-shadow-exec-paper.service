[Unit]
Description=shadow_exec_tail PAPER executor (parity soak; no live orders)
After=network-online.target pm-shadow-final.service
Wants=network-online.target
# The tailer does not roll to a new JSONL file on its own; restart it whenever
# shadow-final restarts (new file per engine start).
PartOf=pm-shadow-final.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu
# NO EnvironmentFile: systemd gives EnvironmentFile precedence over
# Environment= lines, and shadow_exec_tail.env carries LIVE-ARMING values
# (verify_deploy caught the running process armed-shaped on 2026-07-10; the
# --paper flag and the kill file were the guards that held). The paper
# executor needs no creds; sizing declared explicitly.
Environment=PAPER_MODE=1
Environment=PM_SHADOW_PAPER_MODE=true
Environment=PM_SHADOW_PAPER_TRADE=true
Environment=PM_SHADOW_LIVE_TRADE=false
Environment=PM_SHADOW_JSONL_PATH=/home/ubuntu/data/pm-alpha/shadow-final
Environment=PM_SHADOW_TAIL_STATE_PATH=/home/ubuntu/data/pm-alpha/exec_tail_state.json
Environment=PM_SHADOW_REDEEM_LEDGER_PATH=/home/ubuntu/data/pm-alpha/redeem_ledger.jsonl
Environment=PM_SHADOW_CLIP_USD=10
Environment=PM_SHADOW_CLIP_FRAC=0.01
Environment=PM_SHADOW_MAX_ORDER_NOTIONAL_USD=12
Environment=PM_SHADOW_MAX_MARKET_NOTIONAL_USD=24
Environment=PM_SHADOW_LIVE_KILL_SWITCH_PATH=/home/ubuntu/fade.kill
Environment=RUST_LOG=info
# Give a just-(re)started engine time to create its new JSONL before the
# tailer picks the latest file in the directory.
ExecStartPre=/bin/sleep 5
ExecStart=/home/ubuntu/deploy-main/polymarket-agent/target/release/shadow_exec_tail --paper
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/data/pm-alpha/shadow_exec_tail.log
StandardError=append:/home/ubuntu/data/pm-alpha/shadow_exec_tail.log

[Install]
WantedBy=default.target

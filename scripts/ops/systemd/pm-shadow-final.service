[Unit]
Description=pm-alpha shadow-final (ungated frozen prod config, log-only decisions)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/pm-backtest
ExecStart=/bin/bash /home/ubuntu/pm-backtest/scripts/ops/shadow_final_foreground.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/data/pm-alpha/shadow-final.log
StandardError=append:/home/ubuntu/data/pm-alpha/shadow-final.log

[Install]
WantedBy=default.target

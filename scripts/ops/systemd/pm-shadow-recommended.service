[Unit]
Description=shadow-recommended: gated config MINUS min_entry_ask (PAPER; measures cheap-underdog realization)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu
Environment=SHADOW_RECOMMENDED_OUT=/home/ubuntu/data/pm-alpha/shadow-recommended
Environment=SHADOW_SLUG_PREFIX=btc-updown-5m-
Environment=RUST_LOG=info
ExecStart=/home/ubuntu/pm-backtest/scripts/ops/shadow_recommended_foreground.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/data/pm-alpha/shadow-recommended.log
StandardError=append:/home/ubuntu/data/pm-alpha/shadow-recommended.log

[Install]
WantedBy=default.target
